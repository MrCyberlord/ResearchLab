APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
POSTGRES_USER=researchlab
POSTGRES_PASSWORD=
POSTGRES_DB=researchlab
POSTGRES_PORT=5433
# Supply a URL-encoded password matching POSTGRES_PASSWORD. Never commit .env.
DATABASE_URL=

# Ingestion limits (bytes, pages, characters, seconds and MiB).
MAX_UPLOAD_BYTES=10485760
PDF_MAX_PAGES=200
PDF_MAX_CHARS=2000000
PDF_TIMEOUT_SECONDS=15
PDF_MEMORY_MB=256
MAX_CHUNKS=5000
# Character-based chunking, within each page; overlap must be smaller than size.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Local CPU semantic model. Use local/local-hash-v1 only for a legacy lexical corpus.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=.cache/models
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CPU_THREADS=2

# Retrieval: exact pgvector cosine ranking; score is not a confidence probability.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.25
# UTF-8 byte budgets for source text and the combined system/question/source prompt.
RAG_MAX_CONTEXT_BYTES=4000
RAG_MAX_PROMPT_BYTES=6000
# Real local generation via native Ollama. No API key or automatic model pull/fallback.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=120
LLM_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=512
LLM_MAX_RESPONSE_BYTES=65536

# Offline evaluation adds no production settings. It uses the database above only
# for a private transaction-scoped schema and reuses the configured local providers.
