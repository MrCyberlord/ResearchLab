APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
POSTGRES_USER=researchlab
POSTGRES_PASSWORD=
POSTGRES_DB=researchlab
POSTGRES_PORT=5433
# Supply a URL-encoded password matching POSTGRES_PASSWORD. Never commit .env.
DATABASE_URL=

# Ingestion limits (bytes, pages, characters, seconds and MiB).
MAX_UPLOAD_BYTES=10485760
PDF_MAX_PAGES=200
PDF_MAX_CHARS=2000000
PDF_TIMEOUT_SECONDS=15
PDF_MEMORY_MB=256
MAX_CHUNKS=5000
# Character-based chunking, within each page; overlap must be smaller than size.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Local CPU semantic model. Use local/local-hash-v1 only for a legacy lexical corpus.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=.cache/models
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CPU_THREADS=2

# Retrieval: exact pgvector cosine ranking; score is not a confidence probability.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.25
# semantic remains the default; hybrid adds PostgreSQL FTS + RRF, and
# hybrid_rerank additionally loads the pinned local cross-encoder lazily.
RETRIEVAL_STRATEGY=semantic
SEMANTIC_CANDIDATE_COUNT=20
KEYWORD_CANDIDATE_COUNT=20
RRF_FUSION_CONSTANT=60
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
RERANKER_CACHE_DIR=.cache/models
RERANKER_LOCAL_FILES_ONLY=false
RERANKER_BATCH_SIZE=16
RERANKER_CPU_THREADS=2
RERANKER_CANDIDATE_COUNT=20
# UTF-8 byte budgets for source text and the combined system/question/source prompt.
RAG_MAX_CONTEXT_BYTES=4000
RAG_MAX_PROMPT_BYTES=6000
# Real local generation via native Ollama. No API key or automatic model pull/fallback.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=120
LLM_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=512
LLM_MAX_RESPONSE_BYTES=65536
# Retry only pre-response TCP connection failures; generation/read timeouts are not retried.
LLM_CONNECT_RETRIES=1

# Milestone 3B Agentic execution: LLM decisions plus bounded document-search calls.
# It has no web tools, persistence, memory or automatic provider fallback.
AGENT_GRAPH_STEP_LIMIT=20
AGENT_EXECUTION_TIMEOUT_SECONDS=120
AGENT_MAX_QUESTION_CHARS=2000
AGENT_MAX_OUTPUT_TOKENS=384
AGENT_MAX_RESPONSE_BYTES=65536
AGENT_MAX_TOOL_CALLS=3
AGENT_TOOL_TOP_K=5
AGENT_MAX_EVIDENCE_CHUNKS=12
AGENT_DECISION_CONTEXT_BYTES=4000
AGENT_MAX_CONTEXT_BYTES=4000
AGENT_MAX_PROMPT_BYTES=6000

# Offline evaluation adds no production settings. It uses the database above only
# for a private transaction-scoped schema and reuses the configured local providers.
